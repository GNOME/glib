#: gio/gappinfo.c:376
msgid "Setting default applications not supported yet"
msgstr "ᱰᱤᱯᱷᱚᱞᱴ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱥᱮᱴᱤᱝ ᱫᱚ ᱱᱤᱛ ᱦᱚᱸ ᱵᱟᱝ ᱥᱟᱯᱚᱨᱴ ᱟᱠᱟᱱᱟ"

#: gio/gappinfo.c:408
msgid "Setting application as last used for type not supported yet"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱥᱮᱴᱤᱝ ᱫᱚ ᱢᱩᱪᱟᱹᱫ ᱵᱮᱵᱷᱟᱨ ᱞᱮᱠᱟ ᱞᱟᱹᱜᱤᱫ ᱱᱤᱛ ᱦᱚᱸ ᱵᱟᱝ ᱥᱟᱯᱚᱨᱴ ᱟᱠᱟᱱᱟ"

#: gio/gappinfo.c:595
#, c-format
msgid "Invalid file extension ‘%s’"
msgstr "ᱵᱟᱝ ᱵᱮᱥ ᱨᱮᱫ ᱮᱠᱥᱴᱮᱱᱥᱚᱱ ‘%s’"

#: gio/gappinfo.c:1011
#, c-format
msgid "Failed to find default application for content type ‘%s’"
msgstr "ᱡᱤᱱᱤᱥ ᱞᱮᱠᱟᱱ ‘%s’ ᱞᱟᱹᱜᱤᱫ ᱰᱤᱯᱷᱚᱞᱴ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱧᱟᱢ ᱨᱮ ᱵᱟᱝ ᱥᱟᱹᱛ ᱟᱠᱟᱱᱟ"

#: gio/gappinfo.c:1073
#, c-format
msgid "Failed to find default application for URI Scheme ‘%s’"
msgstr "URI ᱥᱠᱤᱢ ‘%s’ ᱞᱟᱹᱜᱤᱫ ᱰᱤᱯᱷᱚᱞᱴ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱧᱟᱢ ᱨᱮ ᱵᱟᱝ ᱥᱟᱹᱛ ᱟᱠᱟᱱᱟ"

#: gio/gapplication.c:507
msgid "GApplication Options:"
msgstr "ᱡᱤ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱚᱯᱥᱚᱱᱥ:"

#: gio/gapplication.c:507
msgid "Show GApplication options"
msgstr "ᱡᱤ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱚᱯᱥᱚᱱ ᱩᱫᱩᱜ ᱢᱮ"

#: gio/gapplication.c:552
msgid "Enter GApplication service mode (use from D-Bus service files)"
msgstr "ᱡᱤ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱥᱮᱵᱟ ᱢᱚᱰ ᱮᱢ ᱢᱮ (D-Bus ᱥᱮᱵᱟ ᱨᱮᱫ ᱠᱷᱚᱱ ᱵᱮᱵᱷᱟᱨ ᱢᱮ)"

#: gio/gapplication.c:564
msgid "Override the application’s ID"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱨᱮᱭᱟᱜ ID ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱢᱮ"

#: gio/gapplication.c:575
msgid "Print the application version"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱵᱷᱟᱨᱥᱚᱱ ᱯᱨᱤᱱᱴ ᱢᱮ"

#: gio/gapplication.c:587
msgid "Replace the running instance"
msgstr "ᱪᱟᱹᱞᱩ ᱠᱟᱱ ᱫᱟᱹᱭᱠᱟᱹ ᱵᱚᱫᱚᱞ ᱢᱮ"

#: gio/gapplication-tool.c:47 gio/gapplication-tool.c:48 gio/gio-tool.c:230
#: gio/gresource-tool.c:497 gio/gsettings-tool.c:593
msgid "Print help"
msgstr "ᱪᱷᱟᱯᱟ ᱜᱚᱲᱚ"

#: gio/gapplication-tool.c:49 gio/gresource-tool.c:498 gio/gresource-tool.c:566
msgid "[COMMAND]"
msgstr "[ᱟᱫᱮᱥ]"

#: gio/gapplication-tool.c:51 gio/gio-tool.c:231
msgid "Print version"
msgstr "ᱪᱷᱟᱯᱟ ᱵᱷᱟᱨᱥᱚᱱ"

#: gio/gapplication-tool.c:52 gio/gsettings-tool.c:599
msgid "Print version information and exit"
msgstr "ᱵᱷᱟᱨᱥᱚᱱ ᱵᱤᱵᱨᱚᱬ ᱪᱷᱟᱯᱟᱭ ᱢᱮ ᱟᱨ ᱚᱰᱚᱠᱚᱜ ᱢᱮ"

#: gio/gapplication-tool.c:55
msgid "List applications"
msgstr "ᱟᱹᱨᱡᱤ ᱥᱟᱠᱟᱢ"

#: gio/gapplication-tool.c:56
msgid "List the installed D-Bus activatable applications (by .desktop files)"
msgstr ""
"ᱤᱱᱥᱴᱚᱞ ᱠᱟᱱ D-Bus ᱮᱠᱴᱤᱵᱷᱮᱴᱮᱵᱚᱞ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱠᱚ ᱥᱩᱪᱤ ᱢᱮ (.ᱰᱮᱥᱠᱴᱚᱯ ᱨᱮᱫ ᱠᱚ ᱦᱚᱛᱮᱛᱮ)"

#: gio/gapplication-tool.c:59
msgid "Launch an application"
msgstr "ᱢᱤᱫ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱞᱚᱱᱪ ᱢᱮ"

#: gio/gapplication-tool.c:60
msgid "Launch the application (with optional files to open)"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱞᱚᱱᱪ ᱢᱮ (ᱡᱷᱤᱡᱽ ᱞᱟᱹᱜᱤᱫ ᱚᱯᱥᱚᱱᱟᱞ ᱨᱮᱫ ᱠᱚ ᱥᱟᱶᱛᱮ)"

#: gio/gapplication-tool.c:61
msgid "APPID [FILE…]"
msgstr "ᱮᱯᱯᱤᱰ [ᱨᱮᱫ...]"

#: gio/gapplication-tool.c:63
msgid "Activate an action"
msgstr "ᱢᱤᱫ ᱠᱟᱹᱢᱤ ᱮᱠᱴᱤᱵᱷᱮᱴ ᱢᱮ"

#: gio/gapplication-tool.c:64
msgid "Invoke an action on the application"
msgstr "ᱟᱹᱨᱡᱤ ᱥᱟᱠᱟᱢ ᱨᱮ ᱢᱤᱫ ᱠᱟᱹᱢᱤ ᱦᱚᱦᱚᱭ ᱢᱮ"

#: gio/gapplication-tool.c:65
msgid "APPID ACTION [PARAMETER]"
msgstr "ᱮᱯᱯᱤᱰ ᱠᱟᱹᱢᱤ [ᱯᱮᱨᱟᱢᱤᱴᱟᱨ]"

#: gio/gapplication-tool.c:67
msgid "List available actions"
msgstr "ᱢᱮᱱᱟᱜ ᱠᱟᱹᱢᱤ ᱠᱚ ᱥᱩᱪᱤ ᱢᱮ"

#: gio/gapplication-tool.c:68
msgid "List static actions for an application (from .desktop file)"
msgstr "ᱢᱤᱫ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱞᱟᱹᱜᱤᱫ ᱥᱴᱮᱴᱤᱠ ᱠᱟᱹᱢᱤ ᱠᱚ ᱥᱩᱪᱤ ᱢᱮ (.ᱰᱮᱥᱠᱴᱚᱯ ᱨᱮᱫ ᱠᱷᱚᱱ)"

#: gio/gapplication-tool.c:69 gio/gapplication-tool.c:75
msgid "APPID"
msgstr "ᱮᱯᱯᱤᱰ"

#: gio/gapplication-tool.c:74 gio/gapplication-tool.c:137 gio/gdbus-tool.c:110
#: gio/gio-tool.c:259 gio/glib-compile-resources.c:843
msgid "COMMAND"
msgstr "ᱟᱫᱮᱥ"

#: gio/gapplication-tool.c:74
msgid "The command to print detailed help for"
msgstr "ᱯᱩᱥᱴᱟᱹᱣ ᱜᱚᱲᱚ ᱞᱟᱹᱜᱤᱫ ᱪᱷᱟᱯᱟ ᱞᱟᱹᱜᱤᱫ ᱟᱫᱮᱥ"

#: gio/gapplication-tool.c:75
msgid "Application identifier in D-Bus format (eg: org.example.viewer)"
msgstr "D-Bus ᱨᱩᱯ ᱨᱮ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱩᱨᱩᱢ (ᱡᱮᱞᱠᱟ: ᱚᱨᱜᱽ.ᱫᱟᱹᱭᱠᱟᱹ.ᱧᱮᱧᱮᱞᱤᱭᱟᱹ)"

#. Translators: commandline placeholder
#: gio/gapplication-tool.c:76 gio/glib-compile-resources.c:831
#: gio/glib-compile-resources.c:837 gio/glib-compile-resources.c:867
#: gio/gresource-tool.c:504 gio/gresource-tool.c:570
#: girepository/compiler/compiler.c:148 girepository/compiler/compiler.c:149
#: girepository/compiler/compiler.c:168 girepository/decompiler/decompiler.c:52
#: girepository/decompiler/decompiler.c:65
msgid "FILE"
msgstr "ᱨᱮᱫᱽ"

#: gio/gapplication-tool.c:76
msgid "Optional relative or absolute filenames, or URIs to open"
msgstr "ᱚᱯᱥᱚᱱᱟᱞ ᱥᱟᱹᱜᱟᱹᱭ ᱥᱮ ᱯᱩᱨᱟᱹ ᱨᱮᱫ ᱧᱩᱛᱩᱢ, ᱥᱮ ᱡᱷᱤᱡᱽ ᱞᱟᱹᱜᱤᱫ URIs"

#: gio/gapplication-tool.c:77
msgid "ACTION"
msgstr "ᱠᱟᱢᱤ"

#: gio/gapplication-tool.c:77
msgid "The action name to invoke"
msgstr "ᱟᱦᱟᱲᱟ ᱞᱟᱹᱜᱤᱫ ᱠᱟᱹᱢᱤ ᱧᱩᱛᱩᱢ"

#: gio/gapplication-tool.c:78
msgid "PARAMETER"
msgstr "ᱯᱮᱨᱟᱢᱤᱴᱟᱨ"

#: gio/gapplication-tool.c:78
msgid "Optional parameter to the action invocation, in GVariant format"
msgstr "ᱠᱟᱹᱢᱤ ᱦᱚᱦᱚ ᱞᱟᱹᱜᱤᱫ ᱚᱯᱥᱚᱱᱟᱞ ᱯᱮᱨᱟᱢᱤᱴᱟᱨ, ᱡᱤᱣᱮᱨᱤᱭᱟᱱᱴ ᱨᱩᱯ ᱨᱮ"

#: gio/gapplication-tool.c:100 gio/gresource-tool.c:535
#: gio/gsettings-tool.c:685
#, c-format
msgid ""
"Unknown command %s\n"
"\n"
msgstr ""
"ᱵᱟᱝ ᱵᱟᱰᱟᱭ ᱟᱫᱮᱥ %s\n"
"\n"

#: gio/gapplication-tool.c:105
msgid "Usage:\n"
msgstr "ᱵᱮᱵᱷᱟᱨ:\n"

#: gio/gapplication-tool.c:118 gio/gresource-tool.c:560
#: gio/gsettings-tool.c:720
msgid "Arguments:\n"
msgstr "ᱟᱨᱜᱩᱢᱮᱱᱴᱥ:\n"

#: gio/gapplication-tool.c:137 gio/gio-tool.c:259
msgid "[ARGS…]"
msgstr "[ARGS…]"

#: gio/gapplication-tool.c:138
#, c-format
msgid "Commands:\n"
msgstr "ᱟᱫᱮᱥᱠᱚᱺ\n"

#. Translators: do not translate 'help', but please translate 'COMMAND'.
#: gio/gapplication-tool.c:150
#, c-format
msgid ""
"Use “%s help COMMAND” to get detailed help.\n"
"\n"
msgstr ""
"ᱯᱩᱥᱴᱟᱹᱣ ᱜᱚᱲᱚ ᱧᱟᱢ ᱞᱟᱹᱜᱤᱫ “%s ᱜᱚᱲᱚ ᱟᱫᱮᱥ” ᱵᱮᱵᱷᱟᱨ ᱢᱮ᱾\n"
"\n"

#: gio/gapplication-tool.c:169
#, c-format
msgid ""
"%s command requires an application id to directly follow\n"
"\n"
msgstr ""
"%s ᱠᱚᱢᱟᱱᱰ ᱥᱚᱡᱷᱮ ᱯᱟᱧᱡᱟ ᱞᱟᱹᱜᱤᱫ ᱢᱤᱫ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱟᱭᱤ ᱰᱤ ᱞᱟᱹᱠᱛᱤᱜ ᱠᱟᱱᱟ\n"
"\n"

#: gio/gapplication-tool.c:175
#, c-format
msgid "invalid application id: “%s”\n"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱟᱭᱤ ᱰᱤ: “%s”\n"

#. Translators: %s is replaced with a command name like 'list-actions'
#: gio/gapplication-tool.c:186
#, c-format
msgid ""
"“%s” takes no arguments\n"
"\n"
msgstr ""
"“%s” ᱫᱚ ᱪᱮᱫ ᱟᱨᱜᱩᱢᱮᱱᱴ ᱵᱟᱝ ᱦᱟᱛᱟᱣᱟ\n"
"\n"

#: gio/gapplication-tool.c:270
#, c-format
msgid "unable to connect to D-Bus: %s\n"
msgstr "D-Bus ᱥᱟᱶ ᱡᱚᱯᱲᱟᱣ ᱵᱟᱝ ᱫᱟᱲᱮᱭᱟᱜ ᱠᱟᱱᱟ: %s\n"

#: gio/gapplication-tool.c:290
#, c-format
msgid "error sending %s message to application: %s\n"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱨᱮ %s ᱠᱷᱚᱵᱚᱨ ᱠᱩᱞ ᱨᱮ ᱦᱩᱰᱟᱹᱜ: ​​%s\n"

#: gio/gapplication-tool.c:324
#, c-format
msgid "action name must be given after application id\n"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱟᱭᱤ ᱰᱤ ᱛᱟᱭᱚᱢ ᱠᱟᱹᱢᱤ ᱧᱩᱛᱩᱢ ᱮᱢ ᱞᱟᱹᱠᱛᱤᱭᱟ\n"

#: gio/gapplication-tool.c:332
#, c-format
msgid ""
"invalid action name: “%s”\n"
"action names must consist of only alphanumerics, “-” and “.”\n"
msgstr ""
"ᱵᱟᱝ ᱴᱷᱤᱠ ᱠᱟᱹᱢᱤ ᱧᱩᱛᱩᱢ: “%s” ᱠᱟᱹᱢᱤ ᱧᱩᱛᱩᱢ ᱨᱮ ᱮᱠᱮᱱ ᱟᱞᱯᱷᱟᱱᱭᱩᱢᱮᱨᱤᱠ, “-” ᱟᱨ “” "
"ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟ᱾\n"

#: gio/gapplication-tool.c:351
#, c-format
msgid "error parsing action parameter: %s\n"
msgstr "ᱦᱤᱲᱤᱡ ᱯᱟᱨᱥᱤᱝ ᱠᱟᱹᱢᱤ ᱯᱮᱨᱟᱢᱤᱴᱟᱨ: %s\n"

#: gio/gapplication-tool.c:363
#, c-format
msgid "actions accept a maximum of one parameter\n"
msgstr "ᱠᱟᱹᱢᱤ ᱠᱚ ᱫᱚ ᱰᱷᱮᱨ ᱠᱟᱛᱮ ᱢᱤᱫ ᱯᱮᱨᱟᱢᱤᱴᱟᱨ ᱠᱚ ᱟᱝᱜᱚᱪᱟ\n"

#: gio/gapplication-tool.c:418
#, c-format
msgid "list-actions command takes only the application id"
msgstr "ᱛᱟᱞᱠᱟ-ᱠᱟᱹᱢᱤ ᱠᱚᱢᱟᱱᱰ ᱫᱚ ᱮᱠᱮᱱ ᱮᱯᱞᱤᱠᱮᱥᱚᱱ ᱟᱭᱤ ᱰᱤ ᱦᱟᱛᱟᱣᱟ"

#: gio/gapplication-tool.c:428
#, c-format
msgid "unable to find desktop file for application %s\n"
msgstr "ᱮᱯᱞᱤᱠᱮᱥᱚᱱ %s ᱞᱟᱹᱜᱤᱫ ᱰᱮᱥᱠᱴᱚᱯ ᱨᱮᱫ ᱵᱟᱝ ᱧᱟᱢ ᱫᱟᱲᱮᱭᱟᱜ ᱠᱟᱱᱟ\n"

#: gio/gapplication-tool.c:473
#, c-format
msgid ""
"unrecognized command: %s\n"
"\n"
msgstr ""
"ᱵᱟᱝ ᱵᱟᱰᱟᱭ ᱟᱫᱮᱥ: %s\n"
"\n"

#: gio/gbufferedinputstream.c:422 gio/gbufferedinputstream.c:500
#: gio/ginputstream.c:181 gio/ginputstream.c:381 gio/ginputstream.c:651
#: gio/ginputstream.c:1056 gio/goutputstream.c:227 gio/goutputstream.c:1052
#: gio/gpollableinputstream.c:217 gio/gpollableoutputstream.c:289
#, c-format
msgid "Too large count value passed to %s"
msgstr "ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱞᱮᱠᱷᱟ ᱜᱚᱱᱚᱝ %s ᱨᱮ ᱯᱟᱥ ᱦᱩᱭ ᱮᱱᱟ"

#: gio/gbufferedinputstream.c:894 gio/gbufferedoutputstream.c:579
#: gio/gdataoutputstream.c:557
msgid "Seek not supported on base stream"
msgstr "ᱵᱮᱥ ᱥᱴᱨᱤᱢ ᱨᱮ ᱵᱟᱝ ᱥᱟᱯᱚᱨᱴ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/gbufferedinputstream.c:941
msgid "Cannot truncate GBufferedInputStream"
msgstr "ᱡᱤ ᱵᱟᱯᱷᱟᱨᱰ ᱤᱱᱯᱩᱴ ᱥᱴᱨᱤᱢ ᱵᱟᱝ ᱴᱨᱟᱱᱠᱮᱴ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/gbufferedinputstream.c:986 gio/ginputstream.c:1252 gio/giostream.c:321
#: gio/goutputstream.c:2214
msgid "Stream is already closed"
msgstr "ᱥᱴᱨᱤᱢ ᱫᱚ ᱞᱟᱦᱟ ᱠᱷᱚᱱ ᱜᱮ ᱵᱚᱱᱫᱚ ᱮᱱᱟ"

#: gio/gbufferedoutputstream.c:616 gio/gdataoutputstream.c:587
msgid "Truncate not supported on base stream"
msgstr "ᱵᱮᱥ ᱥᱴᱨᱤᱢ ᱨᱮ ᱴᱨᱟᱱᱠᱮᱴ ᱵᱟᱭ ᱥᱟᱯᱚᱨᱴ ᱮᱫᱟ"

#: gio/gcancellable.c:327 gio/gdbusconnection.c:2009 gio/gdbusprivate.c:1434
#: gio/gsimpleasyncresult.c:871 gio/gsimpleasyncresult.c:897
#, c-format
msgid "Operation was cancelled"
msgstr "ᱚᱯᱟᱨᱮᱥᱚᱱ ᱵᱚᱱᱫᱚ ᱞᱮᱱᱟ"

#: gio/gcharsetconverter.c:272
msgid "Invalid object, not initialized"
msgstr "ᱵᱟᱝ ᱵᱮᱥ ᱡᱤᱱᱤᱥ, ᱵᱟᱝ ᱮᱦᱚᱵ ᱟᱠᱟᱱᱟ"

