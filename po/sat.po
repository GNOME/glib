#, c-format
msgid "<value nick='%s'/> already specified"
msgstr "<value nick='%s'/> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:122
#, c-format
msgid "value='%s' already specified"
msgstr "ᱜᱚᱱᱚᱝ='%s' ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:136
#, c-format
msgid "flags values must have at most 1 bit set"
msgstr "ᱯᱚᱨᱠᱟ ᱜᱚᱱᱚᱝ ᱠᱚ ᱨᱮ ᱵᱟᱹᱲᱛᱤ ᱑ ᱵᱤᱴ ᱥᱮᱴ ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:161
#, c-format
msgid "<%s> must contain at least one <value>"
msgstr "<%s> ᱨᱮ ᱠᱚᱢ ᱥᱮ ᱠᱚᱢ ᱢᱤᱫ <ᱵᱷᱮᱞᱭᱩ> ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:317
#, c-format
msgid "<%s> is not contained in the specified range"
msgstr "<%s> ᱫᱚ ᱩᱱᱩᱫᱩᱜ ᱯᱟᱥᱱᱟᱣ ᱨᱮ ᱵᱟᱝ ᱢᱮᱱᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:329
#, c-format
msgid "<%s> is not a valid member of the specified enumerated type"
msgstr "<%s> ᱫᱚ ᱩᱫᱩᱜ ᱞᱮᱠᱟᱱ ᱞᱮᱠᱷᱟ ᱨᱮᱱ ᱢᱟᱱᱭᱚ ᱨᱟᱹᱥᱤᱭᱟᱹ ᱫᱚ ᱵᱟᱝ ᱠᱟᱱᱟᱭ"

#: gio/glib-compile-schemas.c:335
#, c-format
msgid "<%s> contains string not in the specified flags type"
msgstr "<%s> ᱨᱮ ᱥᱴᱨᱤᱝ ᱢᱮᱱᱟᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱩᱱᱩᱫᱩᱜ ᱯᱚᱨᱠᱟ ᱞᱮᱠᱟᱱ ᱵᱟᱝ ᱛᱟᱦᱮᱸᱱᱟ"

#: gio/glib-compile-schemas.c:341
#, c-format
msgid "<%s> contains a string not in <choices>"
msgstr "<%s> ᱨᱮ ᱢᱤᱫ ᱥᱴᱨᱤᱝ ᱢᱮᱱᱟᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱫᱚ < choices> ᱨᱮ ᱵᱟᱹᱱᱩᱜᱼᱟ"

#: gio/glib-compile-schemas.c:375
msgid "<range/> already specified for this key"
msgstr "<range/> ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:393
#, c-format
msgid "<range> not allowed for keys of type “%s”"
msgstr "<range> ᱫᱚ “%s” ᱞᱮᱠᱟᱱ ᱪᱟᱹᱵᱤ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱝ ᱫᱟᱣ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:410
#, c-format
msgid "<range> specified minimum is greater than maximum"
msgstr "<range> ᱩᱱᱩᱫᱩᱜ ᱠᱚᱢᱩᱴᱟᱨ ᱫᱚ ᱰᱷᱮᱨ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱢᱟᱨᱟᱝ ᱜᱮᱭᱟ"

#: gio/glib-compile-schemas.c:435
#, c-format
msgid "unsupported l10n category: %s"
msgstr "ᱵᱟᱝ ᱜᱚᱲᱚ ᱧᱟᱢᱚᱜ l10n ᱛᱷᱚᱠ: %s"

#: gio/glib-compile-schemas.c:443
msgid "l10n requested, but no gettext domain given"
msgstr "l10n ᱟᱨᱫᱟᱥ ᱟᱠᱟᱱᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱜᱮᱴᱮᱠᱥ ᱰᱚᱢᱮᱱ ᱵᱟᱝ ᱮᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:455
msgid "translation context given for value without l10n enabled"
msgstr "l10n ᱪᱟᱹᱞᱩ ᱵᱮᱜᱚᱨ ᱜᱚᱱᱚᱝ ᱞᱟᱹᱜᱤᱫ ᱛᱚᱨᱡᱚ ᱥᱟᱛᱟᱢ ᱮᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:477
#, c-format
msgid "Failed to parse <default> value of type “%s”: "
msgstr "ᱯᱟᱨᱥ ᱨᱮ ᱵᱟᱝ ᱥᱟᱹᱛ ᱟᱠᱟᱱᱟ <default> ᱵᱷᱮᱞᱭᱩ ᱞᱮᱠᱟᱱ “%s”: "

#: gio/glib-compile-schemas.c:494
msgid ""
"<choices> cannot be specified for keys tagged as having an enumerated type"
msgstr "<choices> ᱫᱚ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟᱱ ᱴᱮᱜᱽ ᱟᱠᱟᱱ ᱪᱟᱹᱵᱤ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱝ ᱩᱯᱨᱩᱢ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:503
msgid "<choices> already specified for this key"
msgstr "<choices> ᱫᱚ ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:515
#, c-format
msgid "<choices> not allowed for keys of type “%s”"
msgstr "<choices> ᱫᱚ “%s” ᱞᱮᱠᱟᱱ ᱪᱟᱹᱵᱤ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱝ ᱫᱟᱣ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:531
#, c-format
msgid "<choice value='%s'/> already given"
msgstr "<choice value='%s'/> ᱞᱟᱦᱟ ᱨᱮ ᱮᱢ ᱦᱩᱭ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:546
#, c-format
msgid "<choices> must contain at least one <choice>"
msgstr "<choices> ᱨᱮ ᱠᱚᱢ ᱥᱮ ᱠᱚᱢ ᱢᱤᱫ <choices> ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:560
msgid "<aliases> already specified for this key"
msgstr "<aliases> ᱫᱚ ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:564
msgid ""
"<aliases> can only be specified for keys with enumerated or flags types or "
"after <choices>"
msgstr ""
"<aliases> ᱫᱚ ᱥᱩᱢᱩᱝ ᱞᱮᱠᱷᱟ ᱥᱟᱶ ᱥᱮ ᱯᱷᱞᱟᱜᱽ ᱞᱮᱠᱟᱱ ᱥᱮ <choices> ᱛᱟᱭᱚᱢ ᱪᱟᱹᱵᱤ ᱠᱚ "
"ᱞᱟᱹᱜᱤᱫ ᱩᱫᱩᱜ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ᱾"

#: gio/glib-compile-schemas.c:583
#, c-format
msgid ""
"<alias value='%s'/> given when “%s” is already a member of the enumerated "
"type"
msgstr ""
"<alias value='%s'/> ᱮᱢᱚᱜ ᱠᱟᱱᱟ ᱡᱚᱠᱷᱚᱱ “%s” ᱫᱚ ᱞᱟᱦᱟ ᱠᱷᱚᱱ ᱜᱮ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟᱱ "
"ᱨᱟᱹᱥᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ"

#: gio/glib-compile-schemas.c:589
#, c-format
msgid "<alias value='%s'/> given when <choice value='%s'/> was already given"
msgstr ""
"<alias value='%s'/> ᱮᱢ ᱞᱮᱱᱟ ᱡᱚᱠᱷᱚᱱ <choice value='%s'/> ᱞᱟᱦᱟ ᱨᱮ ᱮᱢ ᱞᱮᱱᱟ"

#: gio/glib-compile-schemas.c:597
#, c-format
msgid "<alias value='%s'/> already specified"
msgstr "<alias value='%s'/> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:607
#, c-format
msgid "alias target “%s” is not in enumerated type"
msgstr "ᱮᱞᱤᱭᱟᱥ ᱴᱟᱨᱜᱮᱴ “%s” ᱫᱚ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟᱱ ᱵᱟᱝ ᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:608
#, c-format
msgid "alias target “%s” is not in <choices>"
msgstr "ᱮᱞᱤᱭᱟᱥ ᱴᱟᱨᱜᱮᱴ “%s” ᱫᱚ <choices> ᱨᱮ ᱵᱟᱹᱱᱩᱜᱼᱟ"

#: gio/glib-compile-schemas.c:623
#, c-format
msgid "<aliases> must contain at least one <alias>"
msgstr "<aliases> ᱨᱮ ᱠᱚᱢ ᱥᱮ ᱠᱚᱢ ᱢᱤᱫ <alias> ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:797
msgid "Empty names are not permitted"
msgstr "ᱠᱷᱟᱹᱞᱤ ᱧᱩᱛᱩᱢ ᱫᱚ ᱵᱟᱝ ᱫᱟᱣ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:807
#, c-format
msgid "Invalid name “%s”: names must begin with a lowercase letter"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱧᱩᱛᱩᱢ “%s”: ᱧᱩᱛᱩᱢ ᱠᱚ ᱫᱚ ᱠᱟᱹᱴᱤᱡ ᱪᱤᱠᱤ ᱛᱮ ᱮᱦᱚᱵᱚᱜ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:819
#, c-format
msgid ""
"Invalid name “%s”: invalid character “%c”; only lowercase letters, numbers "
"and hyphen (“-”) are permitted"
msgstr ""
"ᱵᱟᱝ ᱴᱷᱤᱠ ᱧᱩᱛᱩᱢ “%s”: ᱵᱟᱝ ᱴᱷᱤᱠ ᱪᱤᱠᱤ “%c”; ᱥᱩᱢᱩᱝ ᱠᱟᱹᱴᱤᱡ ᱪᱤᱠᱤ, ᱮᱞ ᱟᱨ ᱦᱟᱭᱯᱷᱮᱱ "
"(“-”) ᱫᱚ ᱫᱟᱣ ᱢᱮᱱᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:828
#, c-format
msgid "Invalid name “%s”: two successive hyphens (“--”) are not permitted"
msgstr ""
"ᱵᱟᱝ ᱴᱷᱤᱠ ᱧᱩᱛᱩᱢ “%s”: ᱵᱟᱨ ᱛᱟᱭᱚᱢ ᱛᱟᱭᱚᱢ ᱦᱟᱭᱯᱷᱮᱱ (“--”) ᱫᱚ ᱵᱟᱝ ᱫᱟᱣ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:837
#, c-format
msgid "Invalid name “%s”: the last character may not be a hyphen (“-”)"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱧᱩᱛᱩᱢ “%s”: ᱢᱩᱪᱟᱹᱫ ᱪᱤᱠᱤ ᱫᱚ ᱦᱟᱭᱯᱷᱮᱱ ᱵᱟᱝ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ (“-”)"

#: gio/glib-compile-schemas.c:845
#, c-format
msgid "Invalid name “%s”: maximum length is 1024"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱧᱩᱛᱩᱢ “%s”: ᱰᱷᱮᱨ ᱡᱮᱞᱮᱝ ᱑᱐᱒᱔"

#: gio/glib-compile-schemas.c:917
#, c-format
msgid "<child name='%s'> already specified"
msgstr "<child name='%s'> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:943
msgid "Cannot add keys to a “list-of” schema"
msgstr "ᱥᱠᱤᱢᱟ ᱨᱮᱭᱟᱜ \"ᱛᱟᱞᱠᱟ-ᱛᱟᱞᱠᱟ\" ᱨᱮ ᱪᱟᱹᱵᱤ ᱵᱟᱝ ᱥᱮᱞᱮᱫ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:954
#, c-format
msgid "<key name='%s'> already specified"
msgstr "<key name='%s'> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:972
#, c-format
msgid ""
"<key name='%s'> shadows <key name='%s'> in <schema id='%s'>; use <override> "
"to modify value"
msgstr ""
"<key name='%s'> ᱩᱢᱩᱞ <key name='%s'> <schema id='%s'> ᱨᱮ; ᱜᱚᱱᱚᱝ ᱥᱚᱫᱚᱨ ᱞᱟᱹᱜᱤᱫ "
"<override> ᱵᱮᱵᱷᱟᱨ ᱢᱮ"

#: gio/glib-compile-schemas.c:983
#, c-format
msgid ""
"Exactly one of “type”, “enum” or “flags” must be specified as an attribute "
"to <key>"
msgstr ""
"ᱴᱷᱟᱹᱣᱠᱟᱹ ᱢᱤᱫᱴᱟᱝ “ᱞᱮᱠᱟᱱ”, “ᱮᱱᱟᱢ” ᱵᱟᱝᱠᱷᱟᱱ “ᱯᱚᱨᱠᱟ” ᱫᱚ ᱜᱩᱱ ᱞᱮᱠᱟᱛᱮ ᱩᱫᱩᱜ ᱞᱟᱹᱠᱛᱤᱭᱟ "
"<ᱠᱤ>"

#: gio/glib-compile-schemas.c:1002
#, c-format
msgid "<%s id='%s'> not (yet) defined."
msgstr "<%s id='%s'> ᱵᱟᱝ (ᱱᱤᱛ ᱦᱚᱸ) ᱩᱱᱩᱨᱩᱢ ᱟᱠᱟᱱᱟ ᱾"

#: gio/glib-compile-schemas.c:1017
#, c-format
msgid "Invalid GVariant type string “%s”"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱡᱤᱵᱷᱮᱨᱤᱭᱟᱱᱴ ᱞᱮᱠᱟᱱ ᱥᱴᱨᱤᱝ “%s”"

#: gio/glib-compile-schemas.c:1047
msgid "<override> given but schema isn’t extending anything"
msgstr "<override> ᱮᱢ ᱟᱠᱟᱱᱟ ᱢᱮᱱᱠᱷᱟᱱ ᱥᱠᱤᱢᱟ ᱪᱮᱫ ᱦᱚᱸ ᱵᱟᱭ ᱯᱟᱥᱱᱟᱣ ᱮᱫᱟ"

#: gio/glib-compile-schemas.c:1060
#, c-format
msgid "No <key name='%s'> to override"
msgstr "ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱝ <key name='%s'>"

#: gio/glib-compile-schemas.c:1068
#, c-format
msgid "<override name='%s'> already specified"
msgstr "<override name='%s'> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1141
#, c-format
msgid "<schema id='%s'> already specified"
msgstr "<schema id='%s'> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1153
#, c-format
msgid "<schema id='%s'> extends not yet existing schema “%s”"
msgstr "<schema id='%s'> ᱵᱟᱹᱲᱛᱤ ᱵᱟᱹᱱᱩᱜ ᱥᱠᱤᱢᱟ “%s”"

#: gio/glib-compile-schemas.c:1169
#, c-format
msgid "<schema id='%s'> is list of not yet existing schema “%s”"
msgstr "<schema id='%s'> ᱫᱚ ᱱᱤᱛ ᱦᱚᱸ ᱵᱟᱝ ᱛᱟᱦᱮᱸ ᱠᱟᱱ ᱥᱠᱤᱢᱟ “%s” ᱨᱮᱭᱟᱜ ᱛᱟᱞᱠᱟ ᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1177
#, c-format
msgid "Cannot be a list of a schema with a path"
msgstr "ᱰᱟᱦᱟᱨ ᱥᱟᱶ ᱥᱠᱤᱢᱟ ᱨᱮᱭᱟᱜ ᱛᱟᱞᱠᱟ ᱵᱟᱝ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:1187
#, c-format
msgid "Cannot extend a schema with a path"
msgstr "ᱢᱤᱫ ᱦᱚᱨ ᱥᱟᱶ ᱥᱠᱤᱢᱟ ᱵᱟᱝ ᱯᱟᱥᱱᱟᱣ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/glib-compile-schemas.c:1197
#, c-format
msgid ""
"<schema id='%s'> is a list, extending <schema id='%s'> which is not a list"
msgstr ""
"<schema id='%s'> ᱫᱚ ᱢᱤᱫ ᱛᱟᱞᱠᱟ ᱠᱟᱱᱟ, ᱯᱟᱥᱱᱟᱣ ᱟᱠᱟᱱ <schema id='%s'> ᱚᱠᱟ ᱫᱚ "
"ᱛᱟᱞᱠᱟ ᱵᱟᱝ ᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1207
#, c-format
msgid ""
"<schema id='%s' list-of='%s'> extends <schema id='%s' list-of='%s'> but “%s” "
"does not extend “%s”"
msgstr ""
"<schema id='%s' list-of='%s'> ᱯᱟᱥᱱᱟᱣ ᱮᱫᱟᱭ <schema id='%s' list-of='%s'> "
"ᱢᱮᱱᱠᱷᱟᱱ “%s” ᱵᱟᱭ ᱯᱟᱥᱱᱟᱣᱟ “%s”"

#: gio/glib-compile-schemas.c:1224
#, c-format
msgid "A path, if given, must begin and end with a slash"
msgstr "ᱢᱤᱫ ᱦᱚᱨ, ᱡᱩᱫᱤ ᱮᱢ ᱞᱮᱱᱠᱷᱟᱱ, ᱥᱞᱮᱥ ᱛᱮ ᱮᱦᱚᱵ ᱟᱨ ᱢᱩᱪᱟᱹᱫ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:1231
#, c-format
msgid "The path of a list must end with “:/”"
msgstr "ᱢᱤᱫ ᱛᱟᱞᱠᱟ ᱨᱮᱭᱟᱜ ᱰᱟᱦᱟᱨ ᱫᱚ “:/” ᱥᱟᱶ ᱢᱩᱪᱟᱹᱫᱚᱜ ᱞᱟᱹᱠᱛᱤᱭᱟ"

#: gio/glib-compile-schemas.c:1240
#, c-format
msgid ""
"Warning: Schema “%s” has path “%s”.  Paths starting with “/apps/”, “/"
"desktop/” or “/system/” are deprecated."
msgstr ""
"ᱪᱮᱦᱟᱣᱱᱟ: ᱥᱠᱤᱢᱟ “%s” ᱨᱮ ᱰᱟᱦᱟᱨ “%s” ᱢᱮᱱᱟᱜᱼᱟ᱾ “/ᱮᱯᱥ/”, “/ᱰᱮᱥᱠᱴᱚᱯ/” ᱥᱮ “/"
"ᱥᱤᱥᱴᱚᱢ/” ᱥᱟᱶ ᱮᱦᱚᱵᱚᱜ ᱰᱟᱦᱟᱨ ᱠᱚ ᱫᱚ ᱵᱟᱝ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱᱟ ᱾"

#: gio/glib-compile-schemas.c:1270
#, c-format
msgid "<%s id='%s'> already specified"
msgstr "<%s id='%s'> ᱞᱟᱦᱟ ᱨᱮ ᱜᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1420 gio/glib-compile-schemas.c:1436
#, c-format
msgid "Only one <%s> element allowed inside <%s>"
msgstr "ᱥᱩᱢᱩᱝ ᱢᱤᱫ <%s> ᱫᱩᱨᱤᱵᱽ ᱵᱷᱤᱛᱨᱭ ᱨᱮ ᱫᱟᱣ ᱢᱮᱱᱟᱜᱼᱟ <%s>"

#: gio/glib-compile-schemas.c:1518
#, c-format
msgid "Element <%s> not allowed at the top level"
msgstr "ᱮᱞᱤᱢᱮᱱᱴ <%s> ᱫᱚ ᱪᱮᱛᱟᱱ ᱞᱮᱵᱮᱞ ᱨᱮ ᱵᱟᱝ ᱟᱲᱟᱜ ᱟᱠᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1536
msgid "Element <default> is required in <key>"
msgstr "ᱮᱞᱤᱢᱮᱱᱴ <default> ᱫᱚ <key> ᱨᱮ ᱞᱟᱹᱠᱛᱤᱭᱟᱱᱟ"

#: gio/glib-compile-schemas.c:1626
#, c-format
msgid "Text may not appear inside <%s>"
msgstr "ᱚᱞ ᱫᱚ <%s> ᱵᱷᱤᱛᱨᱭ ᱨᱮ ᱵᱟᱝ ᱧᱮᱞᱚᱜᱼᱟ"

#: gio/glib-compile-schemas.c:1694
#, c-format
msgid "Warning: undefined reference to <schema id='%s'/>"
msgstr "ᱪᱮᱦᱟᱣᱱᱟ: ᱵᱟᱝ ᱩᱱᱩᱫᱩᱜ ᱥᱟᱠᱟᱢ <schema id='%s'/>"

#. Translators: Do not translate "--strict".
#: gio/glib-compile-schemas.c:1833 gio/glib-compile-schemas.c:1912
msgid "--strict was specified; exiting."
msgstr "--ᱠᱮᱴᱮᱡ ᱩᱯᱨᱩᱢ ᱞᱮᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:1845
msgid "This entire file has been ignored."
msgstr "ᱱᱚᱣᱟ ᱜᱚᱴᱟ ᱨᱮᱫ ᱫᱚ ᱵᱟᱝ ᱵᱟᱛᱟᱣ ᱟᱠᱟᱱᱟ ᱾"

#: gio/glib-compile-schemas.c:1908
msgid "Ignoring this file."
msgstr "ᱱᱚᱶᱟ ᱨᱮᱫ ᱵᱟᱝ ᱟᱝᱜᱚᱪ ᱮᱫᱟᱹᱧ ᱾"

#: gio/glib-compile-schemas.c:1963
#, c-format
msgid ""
"No such key “%s” in schema “%s” as specified in override file “%s”; ignoring "
"override for this key."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱨᱮᱫ “%s” ᱨᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱ ᱥᱠᱤᱢᱟ “%s” ᱨᱮ ᱱᱚᱝᱠᱟᱱ ᱠᱤ “%s” ᱵᱟᱹᱱᱩᱜᱼᱟ; ᱱᱚᱣᱟ "
"ᱠᱟᱹᱴᱷᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱵᱟᱛᱟᱣ ᱢᱮ ᱾"

#: gio/glib-compile-schemas.c:1971
#, c-format
msgid ""
"No such key “%s” in schema “%s” as specified in override file “%s” and --"
"strict was specified; exiting."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s” ᱨᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱ ᱥᱠᱤᱢᱟ “%s” ᱨᱮ ᱱᱚᱝᱠᱟᱱ ᱠᱤ “%s” ᱟᱨ --strict "
"ᱵᱟᱝ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:1993
#, c-format
msgid ""
"Cannot provide per-desktop overrides for localized key “%s” in schema “%s” "
"(override file “%s”); ignoring override for this key."
msgstr ""
"ᱥᱠᱤᱢᱟ “%s” ᱨᱮ ᱞᱚᱠᱟᱞᱟᱭᱤᱡᱽ ᱠᱤ “%s” ᱞᱟᱹᱜᱤᱫ ᱯᱨᱚ-ᱰᱮᱥᱠᱴᱚᱯ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱮᱢ ᱫᱟᱲᱮᱭᱟᱜ-"
"ᱟ (ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱨᱮᱫ “%s”); ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱵᱟᱛᱟᱣ ᱢᱮ ᱾"

#: gio/glib-compile-schemas.c:2002
#, c-format
msgid ""
"Cannot provide per-desktop overrides for localized key “%s” in schema “%s” "
"(override file “%s”) and --strict was specified; exiting."
msgstr ""
"ᱥᱠᱤᱢᱟ “%s” (ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s”) ᱨᱮ ᱞᱚᱠᱟᱞᱟᱭᱤᱡᱽ ᱠᱤ “%s” ᱞᱟᱹᱜᱤᱫ ᱯᱟᱨ-ᱰᱮᱥᱠᱴᱚᱯ "
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱮᱢ ᱫᱟᱲᱮᱭᱟᱜ-ᱟ ᱟᱨ --strict ᱫᱚ ᱩᱫᱩᱜ ᱞᱮᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:2026
#, c-format
msgid ""
"Error parsing key “%s” in schema “%s” as specified in override file “%s”: "
"%s. Ignoring override for this key."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱨᱮᱫ “%s”: %s ᱨᱮ ᱩᱫᱩᱜ ᱟᱠᱟᱱ ᱞᱮᱠᱟ ᱥᱠᱤᱢᱟ “%s” ᱨᱮ ᱠᱤ “%s” ᱯᱟᱨᱥᱤᱝ ᱨᱮ "
"ᱦᱩᱰᱟᱹᱜ᱾ ᱱᱚᱣᱟ ᱠᱟᱹᱴᱷᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱵᱩᱡᱷᱟᱹᱣ ᱮᱫᱟᱹᱧ ᱾"

#: gio/glib-compile-schemas.c:2038
#, c-format
msgid ""
"Error parsing key “%s” in schema “%s” as specified in override file “%s”: "
"%s. --strict was specified; exiting."
msgstr ""
"Error parsing key “%s” in schema “%s” as specified in override file “%s”: "
"%s. --ᱠᱮᱴᱮᱡ ᱩᱯᱨᱩᱢ ᱞᱮᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:2065
#, c-format
msgid ""
"Override for key “%s” in schema “%s” in override file “%s” is outside the "
"range given in the schema; ignoring override for this key."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s” ᱨᱮ “%s” ᱥᱠᱤᱢᱟ ᱨᱮ “%s” ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱥᱠᱤᱢᱟ ᱨᱮ ᱮᱢ "
"ᱟᱠᱟᱱ ᱯᱟᱥᱱᱟᱣ ᱵᱟᱦᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ; ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱵᱟᱛᱟᱣ ᱢᱮ ᱾"

#: gio/glib-compile-schemas.c:2075
#, c-format
msgid ""
"Override for key “%s” in schema “%s” in override file “%s” is outside the "
"range given in the schema and --strict was specified; exiting."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s” ᱨᱮ “%s” ᱥᱠᱤᱢᱟ ᱨᱮ ᱠᱤ “%s” ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱥᱠᱤᱢᱟ ᱨᱮ ᱮᱢ "
"ᱟᱠᱟᱱ ᱯᱟᱥᱱᱟᱣ ᱵᱟᱦᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ --strict ᱫᱚ ᱩᱫᱩᱜ ᱟᱠᱟᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:2101
#, c-format
msgid ""
"Override for key “%s” in schema “%s” in override file “%s” is not in the "
"list of valid choices; ignoring override for this key."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s” ᱨᱮ “%s” ᱥᱠᱤᱢᱟ ᱨᱮ “%s” ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱫᱚ ᱢᱟᱱᱭᱟ "
"ᱵᱤᱠᱚᱞᱯᱚ ᱛᱟᱞᱠᱟ ᱨᱮ ᱵᱟᱹᱱᱩᱜᱼᱟ; ᱱᱚᱣᱟ ᱪᱟᱹᱵᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱝ ᱵᱟᱛᱟᱣ ᱢᱮ ᱾"

#: gio/glib-compile-schemas.c:2111
#, c-format
msgid ""
"Override for key “%s” in schema “%s” in override file “%s” is not in the "
"list of valid choices and --strict was specified; exiting."
msgstr ""
"ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱯᱷᱟᱭᱤᱞ “%s” ᱨᱮ “%s” ᱥᱠᱤᱢᱟ ᱨᱮ “%s” ᱠᱤ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱷᱟᱨᱟᱭᱤᱰ ᱵᱟᱹᱱᱩᱜ-ᱟ ᱟᱨ "
"--strict ᱫᱚ ᱩᱫᱩᱜ ᱞᱮᱱᱟ; ᱚᱰᱚᱠᱚᱜ"

#: gio/glib-compile-schemas.c:2173
msgid "Where to store the gschemas.compiled file"
msgstr "ᱡᱤᱥᱠᱮᱢᱟᱥ.ᱠᱚᱢᱯᱟᱭᱤᱞᱰ ᱨᱮᱫ ᱚᱠᱟᱨᱮ ᱫᱚᱦᱚᱭᱟ"

#: gio/glib-compile-schemas.c:2174
msgid "Abort on any errors in schemas"
msgstr "ᱥᱠᱤᱢᱟ ᱨᱮ ᱡᱟᱦᱟᱱ ᱦᱩᱰᱟᱹᱜ ᱜᱮ ᱵᱚᱱᱫᱚᱭ ᱢᱮ"

#: gio/glib-compile-schemas.c:2175
msgid "Do not write the gschema.compiled file"
msgstr "ᱡᱤᱥᱠᱤᱢᱟ.ᱠᱚᱢᱯᱟᱭᱤᱞᱰ ᱨᱮᱫ ᱟᱞᱚᱢ ᱚᱞᱟ"

#: gio/glib-compile-schemas.c:2176
msgid "Do not enforce key name restrictions"
msgstr "ᱢᱩᱲᱩᱫ ᱧᱩᱛᱩᱢ ᱵᱟᱨᱚᱱ ᱟᱞᱚᱢ ᱞᱟᱹᱜᱩᱭᱟ"

#: gio/glib-compile-schemas.c:2206
msgid ""
"Compile all GSettings schema files into a schema cache.\n"
"Schema files are required to have the extension .gschema.xml,\n"
"and the cache file is called gschemas.compiled."
msgstr ""
"ᱥᱟᱱᱟᱢ ᱡᱤᱥᱮᱴᱤᱝ ᱥᱠᱤᱢᱟ ᱨᱮᱫ ᱠᱚ ᱢᱤᱫ ᱥᱠᱤᱢᱟ ᱠᱮᱪ ᱨᱮ ᱠᱚᱢᱯᱟᱭᱤᱞ ᱢᱮ ᱾\n"
"ᱥᱠᱤᱢᱟ ᱨᱮᱫ ᱠᱚ ᱨᱮ ᱮᱠᱥᱴᱮᱱᱥᱚᱱ .gschema.xml ᱛᱟᱦᱮᱱ ᱞᱟᱹᱠᱛᱤᱭᱟᱱᱟ,\n"
"ᱟᱨ ᱠᱮᱪ ᱨᱮᱫ ᱫᱚ ᱡᱤᱥᱠᱮᱢᱟᱥ.ᱠᱚᱢᱯᱟᱭᱤᱞᱰ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾"

#: gio/glib-compile-schemas.c:2238
msgid "You should give exactly one directory name"
msgstr "ᱟᱢ ᱴᱷᱟᱹᱣᱠᱟᱹ ᱢᱤᱫ ᱰᱟᱭᱨᱮᱠᱴᱚᱨᱤ ᱧᱩᱛᱩᱢ ᱮᱢ ᱞᱟᱹᱠᱛᱤᱭᱟᱢᱟ"

#: gio/glib-compile-schemas.c:2285
msgid "No schema files found: doing nothing."
msgstr "ᱥᱠᱤᱢᱟ ᱨᱮᱫ ᱵᱟᱝ ᱧᱟᱢ ᱞᱮᱱᱟ: ᱪᱮᱫ ᱦᱚᱸ ᱵᱟᱝ ᱠᱚᱨᱟᱣ ᱠᱟᱱᱟ ᱾"

#: gio/glib-compile-schemas.c:2287
msgid "No schema files found: removed existing output file."
msgstr "ᱥᱠᱤᱢᱟ ᱨᱮᱫ ᱵᱟᱝ ᱧᱟᱢ ᱞᱮᱱᱟ: ᱢᱮᱱᱟᱜ ᱟᱩᱴᱯᱩᱴ ᱨᱮᱫ ᱚᱪᱚᱜ ᱮᱱᱟ᱾"

#: gio/glocalfile.c:573 gio/win32/gwinhttpfile.c:436
#, c-format
msgid "Invalid filename %s"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱨᱮᱫ ᱧᱩᱛᱩᱢ %s"

#: gio/glocalfile.c:1017
#, c-format
msgid "Error getting filesystem info for %s: %s"
msgstr "%s: %s ᱞᱟᱹᱜᱤᱫ ᱨᱮᱫ ᱥᱤᱥᱴᱚᱢ ᱵᱟᱯᱟᱰᱟᱭ ᱧᱟᱢ ᱨᱮ ᱦᱩᱰᱟᱹᱜ"

#. Translators: This is an error message when trying to find
#. * the enclosing (user visible) mount of a file, but none
#. * exists.
#.
#: gio/glocalfile.c:1155
#, c-format
msgid "Containing mount for file %s not found"
msgstr "ᱨᱮᱫ ᱞᱟᱹᱜᱤᱫ ᱢᱟᱩᱱᱴ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ %s ᱵᱟᱝ ᱧᱟᱢ ᱟᱠᱟᱱᱟ"

#: gio/glocalfile.c:1178
msgid "Can’t rename root directory"
msgstr "ᱨᱩᱴ ᱰᱟᱭᱨᱮᱠᱴᱚᱨᱤ ᱨᱮᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱵᱟᱝ ᱵᱚᱫᱚᱞ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ"

#: gio/glocalfile.c:1196 gio/glocalfile.c:1221
#, c-format
msgid "Error renaming file %s: %s"
msgstr "ᱨᱮᱫ ᱧᱩᱛᱩᱢ ᱵᱚᱫᱚᱞ ᱨᱮ ᱦᱩᱰᱟᱹᱜ %s: %s"

#: gio/glocalfile.c:1204
msgid "Can’t rename file, filename already exists"
msgstr ""
"ᱨᱮᱫ ᱨᱮᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱵᱟᱝ ᱵᱚᱫᱚᱞ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ, ᱨᱮᱫ ᱨᱮᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱞᱟᱦᱟ ᱠᱷᱚᱱ ᱜᱮ ᱢᱮᱱᱟᱜᱼᱟ"

#: gio/glocalfile.c:1218 gio/glocalfile.c:2654 gio/glocalfile.c:2682
#: gio/glocalfile.c:2821 gio/glocalfileoutputstream.c:658
msgid "Invalid filename"
msgstr "ᱵᱟᱝ ᱴᱷᱤᱠ ᱨᱮᱫ ᱧᱩᱛᱩᱢ"

#: gio/glocalfile.c:1421 gio/glocalfile.c:1432
#, c-format
msgid "Error opening file %s: %s"
msgstr "ᱨᱮᱫ ᱡᱷᱤᱡᱽ ᱨᱮ ᱦᱩᱰᱟᱹᱜ %s: %s"

#: gio/glocalfile.c:1557
#, c-format
msgid "Error removing file %s: %s"
msgstr "ᱨᱮᱫ ᱚᱪᱚᱜ ᱨᱮ ᱦᱩᱰᱟᱹᱜ %s: %s"

#: gio/glocalfile.c:2111
