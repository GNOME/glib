msgstr "Fann ikkje standardprogram for innhaldstype «%s»"

#: gio/gappinfo.c:1073
#, c-format
msgid "Failed to find default application for URI Scheme ‘%s’"
msgstr "Fann ikkje standardprogram for URI-skjema «%s»"

#: gio/gapplication.c:507
msgid "GApplication Options:"
msgstr "GApplication-val:"

#: gio/gapplication.c:507
msgid "Show GApplication options"
msgstr "Vis GApplication-innstillingar"

#: gio/gapplication.c:552
msgid "Enter GApplication service mode (use from D-Bus service files)"
msgstr "GÅ inn i GApplication-tenestemodus (bruk frå D-Bus-tenestefiler)"

#: gio/gapplication.c:564
msgid "Override the application’s ID"
msgstr "Overstyr ID-en til programmet"

#: gio/gapplication.c:575
msgid "Print the application version"
msgstr "Skriv ut programvareversjonen"

#: gio/gapplication.c:587
msgid "Replace the running instance"
msgstr "Erstatt den køyrande instansen"

#: gio/gapplication-tool.c:47 gio/gapplication-tool.c:48 gio/gio-tool.c:230
#: gio/gresource-tool.c:497 gio/gsettings-tool.c:593
msgid "Print help"
msgstr "Vis hjelp"

#: gio/gapplication-tool.c:49 gio/gresource-tool.c:498 gio/gresource-tool.c:566
msgid "[COMMAND]"
msgstr "[COMMAND]"

#: gio/gapplication-tool.c:51 gio/gio-tool.c:231
msgid "Print version"
msgstr "Utskriftsversjon"

#: gio/gapplication-tool.c:52 gio/gsettings-tool.c:599
msgid "Print version information and exit"
msgstr "Skriv ut versjonsinformasjon og avslutt"

#: gio/gapplication-tool.c:55
msgid "List applications"
msgstr "List opp program"

#: gio/gapplication-tool.c:56
msgid "List the installed D-Bus activatable applications (by .desktop files)"
msgstr "List over installerte D-Bus-aktiverbare program (etter .desktop-filer)"

#: gio/gapplication-tool.c:59
msgid "Launch an application"
msgstr "Start eit program"

#: gio/gapplication-tool.c:60
msgid "Launch the application (with optional files to open)"
msgstr "Start programmet (med valfrie filer som skal opnast)"

#: gio/gapplication-tool.c:61
msgid "APPID [FILE…]"
msgstr "APPID [FIL…]"

#: gio/gapplication-tool.c:63
msgid "Activate an action"
msgstr "Slå på ei handling"

#: gio/gapplication-tool.c:64
msgid "Invoke an action on the application"
msgstr "Utløys ei handling på programmet"

#: gio/gapplication-tool.c:65
msgid "APPID ACTION [PARAMETER]"
msgstr "APPID HANDLING [PARAMETER]"

#: gio/gapplication-tool.c:67
msgid "List available actions"
msgstr "Vis tilgjengelege handlingar"

#: gio/gapplication-tool.c:68
msgid "List static actions for an application (from .desktop file)"
msgstr "Vis statiske handlingar for eit program (frå .desktop-fil)"

#: gio/gapplication-tool.c:69 gio/gapplication-tool.c:75
msgid "APPID"
msgstr "APPID"

#: gio/gapplication-tool.c:74 gio/gapplication-tool.c:137 gio/gdbus-tool.c:110
#: gio/gio-tool.c:259 gio/glib-compile-resources.c:843
msgid "COMMAND"
msgstr "KOMMANDO"

#: gio/gapplication-tool.c:74
msgid "The command to print detailed help for"
msgstr "Kommandoen for å skrive ut detaljert hjelp for"

#: gio/gapplication-tool.c:75
msgid "Application identifier in D-Bus format (eg: org.example.viewer)"
msgstr "Programidentifikator i D-Bus-format (t.d. org.example.viewer)"

#. Translators: commandline placeholder
#: gio/gapplication-tool.c:76 gio/glib-compile-resources.c:831
#: gio/glib-compile-resources.c:837 gio/glib-compile-resources.c:867
#: gio/gresource-tool.c:504 gio/gresource-tool.c:570
#: girepository/compiler/compiler.c:148 girepository/compiler/compiler.c:149
#: girepository/compiler/compiler.c:168 girepository/decompiler/decompiler.c:52
#: girepository/decompiler/decompiler.c:65
msgid "FILE"
msgstr "FIL"

#: gio/gapplication-tool.c:76
msgid "Optional relative or absolute filenames, or URIs to open"
msgstr "Valfri relativ eller absolutt filnamn, eller URI-ar som skal opnast"

#: gio/gapplication-tool.c:77
msgid "ACTION"
msgstr "HANDLING"

#: gio/gapplication-tool.c:77
msgid "The action name to invoke"
msgstr "Namn på handlinga som skal kallast"

#: gio/gapplication-tool.c:78
msgid "PARAMETER"
msgstr "PARAMETER"

#: gio/gapplication-tool.c:78
msgid "Optional parameter to the action invocation, in GVariant format"
msgstr "Valfritt parameter til handlinga, i GVariant-format"

#: gio/gapplication-tool.c:100 gio/gresource-tool.c:535
#: gio/gsettings-tool.c:685
#, c-format
msgid ""
"Unknown command %s\n"
"\n"
msgstr ""
"Ukjend kommando %s\n"
"\n"

#: gio/gapplication-tool.c:105
msgid "Usage:\n"
msgstr "Bruk:\n"

#: gio/gapplication-tool.c:118 gio/gresource-tool.c:560
#: gio/gsettings-tool.c:720
msgid "Arguments:\n"
msgstr "Argument:\n"

#: gio/gapplication-tool.c:137 gio/gio-tool.c:259
msgid "[ARGS…]"
msgstr "[ARG …]"

#: gio/gapplication-tool.c:138
#, c-format
msgid "Commands:\n"
msgstr "Kommandoar:\n"

#. Translators: do not translate 'help', but please translate 'COMMAND'.
#: gio/gapplication-tool.c:150
#, c-format
msgid ""
"Use “%s help COMMAND” to get detailed help.\n"
"\n"
msgstr ""
"Bruk «%s hjelp KOMMANDO» for å få detaljert hjelp.\n"
"\n"

#: gio/gapplication-tool.c:169
#, c-format
msgid ""
"%s command requires an application id to directly follow\n"
"\n"
msgstr ""
"%s kommando krev at program-id kjem rett etterpå\n"
"\n"

#: gio/gapplication-tool.c:175
#, c-format
msgid "invalid application id: “%s”\n"
msgstr "ugyldig program-id: «%s»\n"

#. Translators: %s is replaced with a command name like 'list-actions'
#: gio/gapplication-tool.c:186
#, c-format
msgid ""
"“%s” takes no arguments\n"
"\n"
msgstr ""
"«%s» tek ingen argument\n"
"\n"

#: gio/gapplication-tool.c:270
#, c-format
msgid "unable to connect to D-Bus: %s\n"
msgstr "klarar ikkje kople til D-Bus: %s\n"

#: gio/gapplication-tool.c:290
#, c-format
msgid "error sending %s message to application: %s\n"
msgstr "feil ved sending av %s-melding til programmet: %s\n"

#: gio/gapplication-tool.c:324
#, c-format
msgid "action name must be given after application id\n"
msgstr "namn på handling må opplysast etter program-id\n"

#: gio/gapplication-tool.c:332
#, c-format
msgid ""
"invalid action name: “%s”\n"
"action names must consist of only alphanumerics, “-” and “.”\n"
msgstr ""
"ugyldig handling: «%s»\n"
"handlingsnamn kan berre bestå av alfanumeriske teikn, «-» og «.»\n"

#: gio/gapplication-tool.c:351
#, c-format
msgid "error parsing action parameter: %s\n"
msgstr "feil ved tolking av handling-parameter: %s\n"

#: gio/gapplication-tool.c:363
#, c-format
msgid "actions accept a maximum of one parameter\n"
msgstr "handlingar stadfestar eit maksimum på éin parameter\n"

#: gio/gapplication-tool.c:418
#, c-format
msgid "list-actions command takes only the application id"
msgstr "list-actions-kommandoen tek berre program-id-en"

#: gio/gapplication-tool.c:428
#, c-format
msgid "unable to find desktop file for application %s\n"
msgstr "fann ikkje skrivebordsfil for program %s\n"

#: gio/gapplication-tool.c:473
#, c-format
msgid ""
"unrecognized command: %s\n"
"\n"
msgstr ""
"ukjend kommando: %s\n"
"\n"

#: gio/gbufferedinputstream.c:422 gio/gbufferedinputstream.c:500
#: gio/ginputstream.c:181 gio/ginputstream.c:381 gio/ginputstream.c:651
#: gio/ginputstream.c:1056 gio/goutputstream.c:227 gio/goutputstream.c:1062
#: gio/gpollableinputstream.c:217 gio/gpollableoutputstream.c:289
#, c-format
msgid "Too large count value passed to %s"
msgstr "For stor teljingsverdi sendt til %s"

#: gio/gbufferedinputstream.c:894 gio/gbufferedoutputstream.c:579
#: gio/gdataoutputstream.c:557
msgid "Seek not supported on base stream"
msgstr "Søk ikkje støtta på basestraum"

#: gio/gbufferedinputstream.c:941
msgid "Cannot truncate GBufferedInputStream"
msgstr "Kan ikkje trunkere GBufferedInputStream"

#: gio/gbufferedinputstream.c:986 gio/ginputstream.c:1252 gio/giostream.c:321
#: gio/goutputstream.c:2224
msgid "Stream is already closed"
msgstr "Straumen er allereie stengt"

#: gio/gbufferedoutputstream.c:616 gio/gdataoutputstream.c:587
msgid "Truncate not supported on base stream"
msgstr "Trunkering er ikkje støtta på basestraumen"

#: gio/gcancellable.c:327 gio/gdbusconnection.c:2009 gio/gdbusprivate.c:1434
#: gio/gsimpleasyncresult.c:871 gio/gsimpleasyncresult.c:897
#, c-format
msgid "Operation was cancelled"
msgstr "Operasjonen vart avbroten"

#: gio/gcharsetconverter.c:272
msgid "Invalid object, not initialized"
msgstr "Ugyldig objekt, ikkje initialisert"

#: gio/gcharsetconverter.c:293 gio/gcharsetconverter.c:324
msgid "Incomplete multibyte sequence in input"
msgstr "Ufullstendig fleirbyte-sekvens i inndata"

#: gio/gcharsetconverter.c:330 gio/gcharsetconverter.c:339
msgid "Not enough space in destination"
msgstr "Ikkje nok plass i målmappa"

#: gio/gcharsetconverter.c:357 gio/gdatainputstream.c:842
#: gio/gdatainputstream.c:1276 glib/gconvert.c:358 glib/gconvert.c:790
#: glib/giochannel.c:1543 glib/giochannel.c:1585 glib/giochannel.c:2447
#: glib/gutf8.c:967 glib/gutf8.c:1424
msgid "Invalid byte sequence in conversion input"
msgstr "Ugyldig bytesekvens i inndata for konvertering"

#: gio/gcharsetconverter.c:362 glib/gconvert.c:366 glib/gconvert.c:704
#: glib/giochannel.c:1550 glib/giochannel.c:2462
#, c-format
msgid "Error during conversion: %s"
msgstr "Feil under konvertering: %s"

#: gio/gcharsetconverter.c:460 gio/gsocket.c:1241
msgid "Cancellable initialization not supported"
msgstr "Avbrytbar initialisering ikkje støtta"

#: gio/gcharsetconverter.c:471 glib/gconvert.c:231 glib/giochannel.c:1371
#, c-format
msgid "Conversion from character set “%s” to “%s” is not supported"
msgstr "Konvertering frå teiknsett «%s» til «%s» er ikkje støtta"

#: gio/gcharsetconverter.c:475 glib/gconvert.c:235
#, c-format
msgid "Could not open converter from “%s” to “%s”"
msgstr "Klarte ikkje opne konverteraren frå «%s» til «%s»"

#: gio/gcontenttype-fdo.c:368
#, c-format
msgid "%s type"
msgstr "%s-type"

#: gio/gcontenttype-win32.c:199
msgid "Unknown type"
msgstr "Ukjend type"

#: gio/gcontenttype-win32.c:201
#, c-format
msgid "%s filetype"
msgstr "%s-filtype"

#: gio/gconverteroutputstream.c:432
msgid "Unexpected data after end of conversion"
msgstr "Uventa data etter slutt på konvertering"

#: gio/gcredentials.c:327
msgid "GCredentials contains invalid data"
msgstr "GCredentials inneheld ugyldige data"

#: gio/gcredentials.c:387 gio/gcredentials.c:682
msgid "GCredentials is not implemented on this OS"
msgstr "GCredentials er ikkje implementert på dette operativsystemet"

#: gio/gcredentials.c:546 gio/gcredentials.c:564
msgid "There is no GCredentials support for your platform"
msgstr "Det finst ikkje støtte for GCredentials på plattforma di"

#: gio/gcredentials.c:622
msgid "GCredentials does not contain a process ID on this OS"
msgstr "GCredentials inneheld ikkje ein prosess-ID på dette OS-et"

#: gio/gcredentials.c:676
msgid "Credentials spoofing is not possible on this OS"
msgstr "Det er ikkje mogleg å forfalske innloggingsopplysningar på dette operativsystemet"

#: gio/gdatainputstream.c:298
msgid "Unexpected early end-of-stream"
msgstr "Uventa tidleg slutt på straumen"

#: gio/gdbusaddress.c:159 gio/gdbusaddress.c:231 gio/gdbusaddress.c:318
#, c-format
msgid "Unsupported key “%s” in address entry “%s”"
msgstr "Støttar ikkje nøkkelen «%s» i adresseoppføringa «%s»"

#: gio/gdbusaddress.c:172
#, c-format
msgid "Meaningless key/value pair combination in address entry “%s”"
msgstr "Meiningslaus kombinasjon av nøkkel og verdi i adressefeltet «%s»"

#: gio/gdbusaddress.c:181
#, c-format
msgid ""
"Address “%s” is invalid (need exactly one of path, dir, tmpdir, or abstract "
"keys)"
msgstr ""
"Adressa «%s» er ugyldig (treng nøyaktig éin av nøklane path, dir, tmpdir "
"eller abstract)"

#: gio/gdbusaddress.c:246 gio/gdbusaddress.c:257 gio/gdbusaddress.c:272
#: gio/gdbusaddress.c:333 gio/gdbusaddress.c:344
#, c-format
msgid "Error in address “%s” — the “%s” attribute is malformed"
msgstr "Feil i adresse «%s» — attributt «%s» er feilforma"

#: gio/gdbusaddress.c:414 gio/gdbusaddress.c:679
#, c-format
msgid "Unknown or unsupported transport “%s” for address “%s”"
msgstr "Ukjend eller ustøtta transport «%s» for adresse «%s»"

#: gio/gdbusaddress.c:458
#, c-format
msgid "Address element “%s” does not contain a colon (:)"
msgstr "Adresseelementet «%s» inneheld ikkje kolon (:)"

#: gio/gdbusaddress.c:467
#, c-format
msgid "Transport name in address element “%s” must not be empty"
msgstr "Transportnamn i adresse-elementet «%s» kan ikkje vere tomt"

#: gio/gdbusaddress.c:488
#, c-format
msgid ""
"Key/Value pair %d, “%s”, in address element “%s” does not contain an equal "
"sign"
msgstr ""
"Nøkkel/verdi-par %d, «%s», i adresse-elementet «%s» inneheld ikkje eit "
"likskapsteikn"

#: gio/gdbusaddress.c:499
#, c-format
msgid ""
"Key/Value pair %d, “%s”, in address element “%s” must not have an empty key"
msgstr ""
"Nøkkel/verdi-par %d, «%s», i adresse-elementet «%s» må ikkje ha ein tom "
"nøkkel"

#: gio/gdbusaddress.c:513
#, c-format
msgid ""
"Error unescaping key or value in Key/Value pair %d, “%s”, in address element "
"“%s”"
msgstr ""
"Feil ved dekoding av nøkkel eller verdi i nøkkel/verdi-paret %d, «%s», i "
"adresse-elementet «%s»"

#: gio/gdbusaddress.c:581
#, c-format
msgid ""
"Error in address “%s” — the unix transport requires exactly one of the keys "
"“path” or “abstract” to be set"
msgstr ""
"Feil i adresse «%s» — unix-transport krev at nøyaktig ein av nøklane «path» "
"eller «abstract» er sett"

#. Translators: The first placeholder is a D-Bus connection address,
#. * the second is the literal name of an attribute in the address.
#.
#: gio/gdbusaddress.c:619 gio/gdbusaddress.c:634 gio/gdbusaddress.c:649
#, c-format
msgid "Error in address “%s” — the %s attribute is missing or malformed"
msgstr "Feil i adresse «%s» — %s-attributt manglar eller er feilforma"

#: gio/gdbusaddress.c:671
msgid "Error auto-launching: "
msgstr "Feil ved auto-oppstart: "

#: gio/gdbusaddress.c:724
#, c-format
msgid "Error opening nonce file “%s”: %s"
msgstr "Feil ved opning av nonce-fil «%s»: %s"

#: gio/gdbusaddress.c:743
#, c-format
msgid "Error reading from nonce file “%s”: %s"
msgstr "Feil ved lesing frå nonce-fil «%s»: %s"

#: gio/gdbusaddress.c:752
#, c-format
msgid "Error reading from nonce file “%s”, expected 16 bytes, got %d"
msgstr "Feil ved lesing frå nonce-fil «%s», forventa 16 bytes, fekk %d"

#: gio/gdbusaddress.c:770
#, c-format
msgid "Error writing contents of nonce file “%s” to stream:"
msgstr "Feil ved skriving av innhaldet i nonce-fil «%s» til straum:"

#: gio/gdbusaddress.c:985
msgid "The given address is empty"
msgstr "Den oppgitte adressa er tom"

#: gio/gdbusaddress.c:1098
#, c-format
msgid "Cannot spawn a message bus when AT_SECURE is set"
msgstr "Kan ikkje starte ein meldingsbuss når AT_SECURE er sett"

#: gio/gdbusaddress.c:1105
msgid "Cannot spawn a message bus without a machine-id: "
msgstr "Kan ikkje opprette ein meldingsbuss utan ein maskin-id: "

#: gio/gdbusaddress.c:1112
#, c-format
msgid "Cannot autolaunch D-Bus without X11 $DISPLAY"
msgstr "Kan ikkje autostarte D-Bus utan X11 $DISPLAY"

#: gio/gdbusaddress.c:1154
#, c-format
msgid "Error spawning command line “%s”: "
msgstr "Feil ved oppstart av kommandolinje «%s»: "

#: gio/gdbusaddress.c:1223
#, c-format
msgid "Cannot determine session bus address (not implemented for this OS)"
msgstr ""
"Kan ikkje fastslå sesjonsbussadressa (ikkje implementert for dette "
"operativsystemet)"

#: gio/gdbusaddress.c:1377 gio/gdbusconnection.c:7928
#, c-format
msgid ""
"Cannot determine bus address from DBUS_STARTER_BUS_TYPE environment variable "
"— unknown value “%s”"
msgstr ""
"Kan ikkje fastslå bussadressa frå miljøvariabelen DBUS_STARTER_BUS_TYPE — "
"ukjend verdi «%s»"

#: gio/gdbusaddress.c:1386 gio/gdbusconnection.c:7937
msgid ""
"Cannot determine bus address because the DBUS_STARTER_BUS_TYPE environment "
"variable is not set"
msgstr ""
"Kan ikkje fastslå bussadressa fordi miljøvariabelen DBUS_STARTER_BUS_TYPE "
"ikkje er sett"

#: gio/gdbusaddress.c:1396
#, c-format
msgid "Unknown bus type %d"
msgstr "Ukjend busstype %d"

#: gio/gdbusauth.c:321
msgid "Unexpected lack of content trying to read a line"
msgstr "Uventa mangel på innhald ved lesing av linje"

#: gio/gdbusauth.c:359
msgid "Malformed D-Bus authentication line"
msgstr "Feil D-Bus-autentiseringslinje"

#: gio/gdbusauth.c:377
msgid "Unexpected lack of content trying to (safely) read a line"
msgstr "Uventa mangel på innhald når ein prøver å (trygt) lesa ei linje"

#: gio/gdbusauth.c:521
#, c-format
msgid ""
"Exhausted all available authentication mechanisms (tried: %s) (available: %s)"
msgstr ""
"Utbrukt alle tilgjengelege autentiseringsmekanismar (prøvd: %s) "
"(tilgjengeleg: %s)"

#: gio/gdbusauth.c:1084
msgid "Unexpected lack of content trying to read a byte"
msgstr "Uventa mangel på innhald ved lesing av ein byte"

#: gio/gdbusauth.c:1235
msgid "User IDs must be the same for peer and server"
msgstr "Brukarnamn må vere det same for nodar og tenar"

#: gio/gdbusauth.c:1247
msgid "Cancelled via GDBusAuthObserver::authorize-authenticated-peer"
msgstr "Avbrote via GDBusAuthObserver::authorize-authenticated-peer"

#: gio/gdbusauthmechanismsha1.c:294
msgid ""
"Error accessing D-Bus keyring: keyring-based authentication is not supported "
"when running as setuid"
msgstr ""
"Feil ved tilgang til D-Bus-nøkkelring: nøkkelring-basert autentisering er "
"ikkje støtta når det køyrer som setuid"

#: gio/gdbusauthmechanismsha1.c:321
#, c-format
msgid "Error when getting information for directory “%s”: %s"
msgstr "Feil ved innhenting av informasjon for mappe «%s»: %s"

#: gio/gdbusauthmechanismsha1.c:336
#, c-format
msgid ""
"Permissions on directory “%s” are malformed. Expected mode 0700, got 0%o"
msgstr "Rettar på mappe «%s» er feil. Forventa tilstand 0700, fekk 0%o"

#: gio/gdbusauthmechanismsha1.c:367
#, c-format
msgid "Error creating directory “%s”: %s"
msgstr "Feil ved oppretting av mappe «%s»: %s"

#: gio/gdbusauthmechanismsha1.c:412
#, c-format
msgid "Error opening keyring “%s” for reading: "
msgstr "Feil ved opning av nøkkelring «%s» for lesing: "

#: gio/gdbusauthmechanismsha1.c:435 gio/gdbusauthmechanismsha1.c:776
#, c-format
msgid "Line %d of the keyring at “%s” with content “%s” is malformed"
msgstr "Linje %d i nøkkelringen ved «%s» med innhald «%s» er feilforma"

#: gio/gdbusauthmechanismsha1.c:449 gio/gdbusauthmechanismsha1.c:790
#, c-format
msgid ""
"First token of line %d of the keyring at “%s” with content “%s” is malformed"
msgstr ""
"Første token i linje %d i nøkkelringen på «%s» med innhald «%s» er dårleg "
"formatert"

#: gio/gdbusauthmechanismsha1.c:463 gio/gdbusauthmechanismsha1.c:804
#, c-format
msgid ""
"Second token of line %d of the keyring at “%s” with content “%s” is malformed"
msgstr ""
"Andre token i linje %d i nøkkelringen ved «%s» med innhald «%s» er feilforma"

#: gio/gdbusauthmechanismsha1.c:487
#, c-format
msgid "Didn’t find cookie with id %d in the keyring at “%s”"
msgstr "Fann ikkje kake med id %d i nøkkelringen på «%s»"

#: gio/gdbusauthmechanismsha1.c:544
#, c-format
msgid "Error creating lock file “%s”: %s"
msgstr "Feil ved oppretting av låsfil «%s»: %s"

#: gio/gdbusauthmechanismsha1.c:617
#, c-format
msgid "Error deleting stale lock file “%s”: %s"
msgstr "Feil sletting av utgått låsfil «%s»: %s"

