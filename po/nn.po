#: gio/gappinfo.c:376
msgid "Setting default applications not supported yet"
msgstr "Støttar enno ikkje å setje standardprogram"

#: gio/gappinfo.c:408
msgid "Setting application as last used for type not supported yet"
msgstr "Å setje programmet som sist brukt for typen er ikkje støtta enno"

#: gio/gappinfo.c:595
#, c-format
msgid "Invalid file extension ‘%s’"
msgstr "Ugyldig filending «%s»"

